{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32H5 (ST-LINK)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/GatewayV2.elf",
            "servertype": "stlink",
            "serverpath": "D:/stm32cubeclt/STM32CubeCLT_1.21.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
            "stm32cubeprogrammer": "D:/stm32cubeclt/STM32CubeCLT_1.21.0/STM32CubeProgrammer/bin",
            "armToolchainPath": "D:/stm32cubeclt/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin",
            "device": "STM32H563VITx",
            "interface": "swd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "serverArgs": ["-m", "0"]
        }
    ]
}